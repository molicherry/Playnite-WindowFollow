<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- 协议/TLS 回归测试：只链接 src 下的纯协议文件，不依赖 Playnite 安装。 -->
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SunshineWindowFollow.ProtocolTests</AssemblyName>
    <RootNamespace>SunshineWindowFollow.ProtocolTests</RootNamespace>
    <NoWarn>$(NoWarn);SYSLIB0014;SYSLIB0057</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/JsonLite.cs" Link="src/JsonLite.cs" />
    <Compile Include="../../src/SunshineModels.cs" Link="src/SunshineModels.cs" />
    <Compile Include="../../src/SunshineEndpoint.cs" Link="src/SunshineEndpoint.cs" />
    <Compile Include="../../src/SunshineClient.cs" Link="src/SunshineClient.cs" />
  </ItemGroup>

</Project>
